rules_version = '2';
// Template only. The live rules are pasted in the Firebase console (Firestore → Rules),
// with OWNER_UID replaced by the owner's Firebase user ID. Nothing personal is kept in this repo.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'OWNER_UID';
    }

    match /users/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;
      match /expenses/{id} {
        allow read, write: if isOwner() && request.auth.uid == uid;
      }
    }

    match /trips/{tripId} {
      allow get: if isOwner();
      allow list: if isOwner() && request.auth.uid in resource.data.memberUids;
      allow create: if isOwner()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if isOwner() && request.auth.uid in resource.data.memberUids;
      allow delete: if isOwner() && resource.data.owner == request.auth.uid;
      match /expenses/{id} {
        allow read, write: if isOwner()
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
