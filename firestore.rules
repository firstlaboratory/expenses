rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private: only Guru's Google account can read or write anything.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'OWNER_EMAIL_REMOVED'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;
      match /expenses/{id} {
        allow read, write: if isOwner() && request.auth.uid == uid;
      }
    }

    match /trips/{tripId} {
      allow get: if isOwner();
      allow list: if isOwner() && request.auth.uid in resource.data.memberUids;
      allow create: if isOwner()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if isOwner() && request.auth.uid in resource.data.memberUids;
      allow delete: if isOwner() && resource.data.owner == request.auth.uid;
      match /expenses/{id} {
        allow read, write: if isOwner()
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
      }
    }
  }
}
